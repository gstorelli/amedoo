# Copia in .env e adatta (cp .env.example .env)

# Rete Docker dove gira nginx-proxy — verifica il nome reale con:
#   docker network ls
PROXY_NETWORK=nginx-proxy

# Domini del sito (separati da virgola, senza spazi)
VIRTUAL_HOST=associazioneamedoo.it,www.associazioneamedoo.it
LETSENCRYPT_HOST=associazioneamedoo.it,www.associazioneamedoo.it

# Area riservata: sottodominio (serve un record DNS A verso lo stesso IP)
ADMIN_HOST=gestione.associazioneamedoo.it
ADMIN_USER=amedoo
ADMIN_PASSWORD=cambiami

# Email per le notifiche di scadenza del certificato
LETSENCRYPT_EMAIL=segreteriaamedoo@gmail.com
